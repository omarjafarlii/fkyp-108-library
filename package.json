{
  "name": "lesson-42-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset && prisma generate",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/server.js",
    "flood": "node scripts/flood.mjs",
    "race": "node scripts/race.mjs",
    "reset-book": "tsx scripts/reset-book.ts",
    "seed-books": "tsx scripts/seed-books.ts",
    "check-pages": "node scripts/check-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tests",
    "frontend": "node scripts/frontend.mjs",
    "brute": "node scripts/brute.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
